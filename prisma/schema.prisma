generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id           String   @id
  date         String
  branch       String
  category     String
  description  String
  amount       Float    // Original amount
  currency     String   @default("USD") // "USD", "VES"
  exchangeRate Float    @default(1.0)   // Rate to USD at time of transaction
  amountUsd    Float    @default(0.0)   // Computed USD value
  amountVes    Float    @default(0.0)   // Computed VES value
  status       String
}

model Branch {
  name String @id
}

model Category {
  name String @id
}

model ExchangeRate {
  id        String   @id @default("latest")
  bcv       Float    @default(40.0) // USD to VES BCV rate
  paralelo  Float    @default(40.0) // USD to VES Parallel rate
  euro      Float    @default(45.0) // EUR to VES Official rate
  usdt      Float    @default(40.0) // USD to VES Cripto/USDT rate
  updatedAt DateTime @updatedAt
}

model RecurringPayment {
  id          String @id @default(uuid())
  description String
  dayOfMonth  Int
  amount      Float
  branch      String
  category    String
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String // Hashed password
  name     String
  role     String @default("admin")
}